{
  "redirects": [
    {
      "source": "/yogami",
      "destination": "https://yorigam.com",
      "permanent": true
    },
    {
      "source": "/yogami/",
      "destination": "https://yorigam.com",
      "permanent": true
    },
    {
      "source": "/how-privates-work",
      "destination": "/private-sessions#how-it-works",
      "permanent": true
    },
    {
      "source": "/how-privates-work/",
      "destination": "/private-sessions#how-it-works",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(admin|onboard|cv|story|handstandguide|pinchaguide)",
      "destination": "/shell.html"
    },
    {
      "source": "/(admin|onboard|cv|story|handstandguide|pinchaguide)/",
      "destination": "/shell.html"
    },
    {
      "source": "/events/:slug",
      "destination": "/shell.html"
    },
    {
      "source": "/events/:slug/",
      "destination": "/shell.html"
    }
  ]
}
